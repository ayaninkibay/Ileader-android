<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash icon for Android 12+ Splash API.
    Canvas: 108×108. Content occupies inner ~44% so it fits the
    safe-zone circle (192/288 ≈ 66%) without clipping on adaptive devices.
    Geometry mirrors ic_launcher_foreground.xml; colours tuned for the
    light splash background (#F5F5F7). Wrapped in a named group so the
    animated-vector wrapper can target it for the entrance scale-in.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:name="root_anim"
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1"
        android:scaleY="1">

        <!-- Trophy cup body — brand red on light bg -->
        <path
            android:fillColor="#E53535"
            android:pathData="M40,30 L68,30 L65,54 Q54,58 43,54 Z" />

        <!-- Cup highlight (subtle darker red on the left) -->
        <path
            android:fillColor="#C62828"
            android:pathData="M40,30 L48,30 L46,52 Q44,53 43,54 Z" />

        <!-- Left handle -->
        <path
            android:fillColor="#E53535"
            android:pathData="M40,33 C40,33 30,33 30,43 C30,50 36,52 40,50"
            android:strokeWidth="3"
            android:strokeColor="#E53535" />

        <!-- Right handle -->
        <path
            android:fillColor="#E53535"
            android:pathData="M68,33 C68,33 78,33 78,43 C78,50 72,52 68,50"
            android:strokeWidth="3"
            android:strokeColor="#E53535" />

        <!-- Stem -->
        <path
            android:fillColor="#E53535"
            android:pathData="M50,54 L58,54 L56,64 L52,64 Z" />

        <!-- Base -->
        <path
            android:fillColor="#E53535"
            android:pathData="M42,64 Q42,62 44,62 L64,62 Q66,62 66,64 L66,67 Q66,69 64,69 L44,69 Q42,69 42,67 Z" />

        <!-- Star on cup — white to read against the red trophy -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M54,36 L56.2,42 L62.5,42.2 L57.6,46.2 L59.3,52.3 L54,49 L48.7,52.3 L50.4,46.2 L45.5,42.2 L51.8,42 Z" />
    </group>
</vector>
