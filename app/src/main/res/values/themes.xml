<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ILeader" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>

    <!--
        Launcher splash. Uses the AndroidX SplashScreen API (core-splashscreen):
        on Android 12+ this hooks into the system splash, on API < 31 it's
        backported. After installSplashScreen() returns, the activity switches
        to postSplashScreenTheme (the real Theme.ILeader) before drawing.

        windowSplashScreenAnimatedIcon points at the launcher foreground PNG
        (the actual iLeader logo) — the old animated-vector wrapper rendered a
        generic trophy, which was the wrong brand. Splash now matches the
        launcher icon. No entrance animation; the splash is brief anyway.
    -->
    <style name="Theme.ILeader.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ILeader</item>
    </style>
</resources>
